+StartTransferRequest TwoPeerPlan(int64_t uuid, const std::string& peer_a,
+                                 const std::string& peer_b) {
+  StartTransferRequest plan = ValidPlan(uuid, /*dtype_tags=*/{""});
+  plan.mutable_pool_groups(0)->set_expected_pushes(2);
+  plan.mutable_pool_groups(0)->set_dst_expected_extent_bytes(0, 32);
+  auto* schedule = &(*plan.mutable_shard_push_schedules())[0];
+  schedule->mutable_entries(0)->set_dst_peer(peer_a);
+  auto* second = schedule->add_entries();
+  *second = schedule->entries(0);
+  second->set_dst_peer(peer_b);
+  second->set_dst_offset_bytes(16);
+  return plan;
+}
