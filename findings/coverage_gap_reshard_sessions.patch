+TEST(PoolReshardRecvTest,
+     OnPoolReceivedUploadsSinglePoolAndWaitsForOpenPushLease) {
+  constexpr int64_t kStride = 128;
+  constexpr int64_t kNumBlocks = 16;
+  BoundedPoolTestManager manager(/*slice_byte_size=*/kStride, /*host_blocks=*/1,
+                                 /*physical_size=*/kStride * kNumBlocks);
+
+  kv_cache::PoolSpec pool = DensePool("fa", kStride, "bf16");
+  pool.num_blocks = kNumBlocks;
+  pool.staging_blocks_per_request = 1;
+  ABSL_ASSERT_OK(manager.base()->RegisterPools({pool}, /*staging_leases=*/2));
+
+  // 1. Open incoming push lease spans OnPoolReceived and synchronous H2D:
+  //    a prior empty push stream ends without settling, then the payload
+  //    stream's OnPoolReceived finishes H2D and marks the session draining
+  //    while keeping staging pinned until EndIncomingPush closes the lease.
+  ABSL_ASSERT_OK(manager.PoolReshardRegisterRecv(ValidPlan(/*uuid=*/4101),
+                                                 std::vector<int64_t>{0}));
+  ASSERT_EQ(manager.base()->PoolStagingSummary()[0].free_slots, 1);
+
+  ABSL_ASSERT_OK(manager.base()->BeginIncomingPush(/*uuid=*/4101));
+  ABSL_EXPECT_OK(
+      manager.base()->EndIncomingPush(/*uuid=*/4101, absl::OkStatus()));
+  EXPECT_TRUE(manager.has_pool_recv(4101));
+  EXPECT_EQ(manager.base()->PoolStagingSummary()[0].free_slots, 1);
+
+  ABSL_ASSERT_OK(manager.base()->BeginIncomingPush(/*uuid=*/4101));
+  ABSL_ASSERT_OK(manager.base()->OnPoolReceived(/*pool_idx=*/0, /*uuid=*/4101));
+  EXPECT_TRUE(manager.has_pool_recv(4101));
+  EXPECT_EQ(manager.base()->PoolStagingSummary()[0].free_slots, 1);
+  EXPECT_TRUE(manager.base()->HasActivePlan(4101));
+
+  ABSL_EXPECT_OK(
+      manager.base()->EndIncomingPush(/*uuid=*/4101, absl::OkStatus()));
+  EXPECT_FALSE(manager.has_pool_recv(4101));
+  EXPECT_EQ(manager.base()->PoolStagingSummary()[0].free_slots, 2);
+  EXPECT_FALSE(manager.base()->HasActivePlan(4101));
+  {
+    const auto [sent, received, failed] = manager.CompleteReadRaw();
+    EXPECT_THAT(received, Contains("pool_reshard_req_4101"));
+    EXPECT_THAT(failed, IsEmpty());
+  }
+
+  // 2. With no incoming push lease open, OnPoolReceived uploads and settles
+  //    immediately when the synchronous H2D callback finishes.
+  ABSL_ASSERT_OK(manager.PoolReshardRegisterRecv(ValidPlan(/*uuid=*/4102),
+                                                 std::vector<int64_t>{0}));
+  ASSERT_EQ(manager.base()->PoolStagingSummary()[0].free_slots, 1);
+  ABSL_ASSERT_OK(manager.base()->OnPoolReceived(/*pool_idx=*/0, /*uuid=*/4102));
+  EXPECT_FALSE(manager.has_pool_recv(4102));
+  EXPECT_EQ(manager.base()->PoolStagingSummary()[0].free_slots, 2);
+  {
+    const auto [sent, received, failed] = manager.CompleteReadRaw();
+    EXPECT_THAT(received, Contains("pool_reshard_req_4102"));
+    EXPECT_THAT(failed, IsEmpty());
+  }
+}
