+TEST(PoolReshardRecvTest,
+     RankWaveGatesHigherRankPoolAndChainsWhileBatchWaitsForPeers) {
+  constexpr int64_t kStride = 128;
+  constexpr int64_t kNumBlocks = 16;
+  BoundedPoolTestManager manager(/*slice_byte_size=*/kStride, /*host_blocks=*/1,
+                                 /*physical_size=*/kStride * kNumBlocks,
+                                 /*num_storages=*/2);
+
+  kv_cache::PoolSpec pool0 = DensePool("fa0", kStride, "bf16");
+  pool0.storage_index = 0;
+  pool0.num_blocks = kNumBlocks;
+  pool0.staging_blocks_per_request = 1;
+  kv_cache::PoolSpec pool1 = DensePool("fa1", kStride, "bf16");
+  pool1.storage_index = 1;
+  pool1.num_blocks = kNumBlocks;
+  pool1.staging_blocks_per_request = 1;
+  ABSL_ASSERT_OK(
+      manager.base()->RegisterPools({pool0, pool1}, /*staging_leases=*/2));
+
+  // 1. Ranks [0, 1]: pool 1 arriving before pool 0 is held back by the rank
+  //    gate; pool 0's upload then chains pool 1's upload to completion.
+  ABSL_ASSERT_OK(manager.PoolReshardRegisterRecv(
+      TwoPoolPlan(/*uuid=*/4111, /*rank_0=*/0, /*rank_1=*/1),
+      std::vector<int64_t>{0, 0}));
+  ASSERT_EQ(manager.base()->PoolStagingSummary()[0].free_slots, 1);
+
+  ABSL_ASSERT_OK(manager.base()->OnPoolReceived(/*pool_idx=*/1, /*uuid=*/4111));
+  EXPECT_TRUE(manager.has_pool_recv(4111));
+  EXPECT_EQ(manager.base()->PoolStagingSummary()[0].free_slots, 1);
+  {
+    const auto [sent, received, failed] = manager.CompleteReadRaw();
+    EXPECT_THAT(received, IsEmpty());
+    EXPECT_THAT(failed, IsEmpty());
+  }
+
+  ABSL_ASSERT_OK(manager.base()->OnPoolReceived(/*pool_idx=*/0, /*uuid=*/4111));
+  EXPECT_FALSE(manager.has_pool_recv(4111));
+  EXPECT_EQ(manager.base()->PoolStagingSummary()[0].free_slots, 2);
+  {
+    const auto [sent, received, failed] = manager.CompleteReadRaw();
+    EXPECT_THAT(received, Contains("pool_reshard_req_4111"));
+    EXPECT_THAT(failed, IsEmpty());
+  }
+
+  // 2. Ranks [0, 0]: pool 0 uploads immediately without settling while pool 1
+  //    has not yet arrived; pool 1 arriving finishes the receive.
+  ABSL_ASSERT_OK(manager.PoolReshardRegisterRecv(
+      TwoPoolPlan(/*uuid=*/4112, /*rank_0=*/0, /*rank_1=*/0),
+      std::vector<int64_t>{0, 0}));
+  ABSL_ASSERT_OK(manager.base()->OnPoolReceived(/*pool_idx=*/0, /*uuid=*/4112));
+  EXPECT_TRUE(manager.has_pool_recv(4112));
+  EXPECT_EQ(manager.base()->PoolStagingSummary()[0].free_slots, 1);
+
+  ABSL_ASSERT_OK(manager.base()->OnPoolReceived(/*pool_idx=*/1, /*uuid=*/4112));
+  EXPECT_FALSE(manager.has_pool_recv(4112));
+  EXPECT_EQ(manager.base()->PoolStagingSummary()[0].free_slots, 2);
+  {
+    const auto [sent, received, failed] = manager.CompleteReadRaw();
+    EXPECT_THAT(received, Contains("pool_reshard_req_4112"));
+    EXPECT_THAT(failed, IsEmpty());
+  }
+}
