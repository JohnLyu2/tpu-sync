+TEST(PoolReshardRecvTest,
+     ConcurrentPushesAndUnregisterDrainBeforeSettling) {
+  constexpr int64_t kStride = 128;
+  constexpr int64_t kNumBlocks = 16;
+  BoundedPoolTestManager manager(/*slice_byte_size=*/kStride, /*host_blocks=*/1,
+                                 /*physical_size=*/kStride * kNumBlocks);
+
+  kv_cache::PoolSpec pool = DensePool("fa", kStride, "bf16");
+  pool.num_blocks = kNumBlocks;
+  pool.staging_blocks_per_request = 1;
+  ABSL_ASSERT_OK(manager.base()->RegisterPools({pool}, /*staging_leases=*/2));
+
+  // 1. Two open push streams across UnregisterActivePlan: the first unregister
+  //    starts draining, a duplicate unregister is a no-op, OnPoolReceived on
+  //    the draining session launches no upload, the first failed push end
+  //    keeps staging pinned, and the second settles the receive.
+  ABSL_ASSERT_OK(manager.PoolReshardRegisterRecv(ValidPlan(/*uuid=*/4121),
+                                                 std::vector<int64_t>{0}));
+  ABSL_ASSERT_OK(manager.base()->BeginIncomingPush(/*uuid=*/4121));
+  ABSL_ASSERT_OK(manager.base()->BeginIncomingPush(/*uuid=*/4121));
+
+  ABSL_ASSERT_OK(manager.UnregisterActivePlan(/*uuid=*/4121));
+  EXPECT_TRUE(manager.has_pool_recv(4121));
+  EXPECT_EQ(manager.base()->PoolStagingSummary()[0].free_slots, 1);
+
+  ABSL_ASSERT_OK(manager.UnregisterActivePlan(/*uuid=*/4121));
+  EXPECT_TRUE(manager.has_pool_recv(4121));
+
+  ABSL_ASSERT_OK(manager.base()->OnPoolReceived(/*pool_idx=*/0, /*uuid=*/4121));
+  EXPECT_TRUE(manager.has_pool_recv(4121));
+  EXPECT_EQ(manager.base()->PoolStagingSummary()[0].free_slots, 1);
+
+  EXPECT_THAT(
+      manager.base()->EndIncomingPush(
+          /*uuid=*/4121, absl::DeadlineExceededError("stream 1 timeout")),
+      StatusIs(absl::StatusCode::kCancelled));
+  EXPECT_TRUE(manager.has_pool_recv(4121));
+  EXPECT_EQ(manager.base()->PoolStagingSummary()[0].free_slots, 1);
+
+  EXPECT_THAT(
+      manager.base()->EndIncomingPush(
+          /*uuid=*/4121, absl::DeadlineExceededError("stream 2 timeout")),
+      StatusIs(absl::StatusCode::kCancelled));
+  EXPECT_FALSE(manager.has_pool_recv(4121));
+  EXPECT_EQ(manager.base()->PoolStagingSummary()[0].free_slots, 2);
+  EXPECT_FALSE(manager.base()->HasActivePlan(4121));
+  {
+    CompleteReadResult res = manager.CompleteReadWithDetails();
+    EXPECT_THAT(res.failed, Contains("pool_reshard_req_4121"));
+    EXPECT_EQ(res.details["pool_reshard_req_4121"].code, "CANCELLED");
+  }
+
+  // 2. First of two concurrent push streams fails directly in EndIncomingPush:
+  //    the session starts draining with the push error while waiting for the
+  //    sibling stream to close.
+  ABSL_ASSERT_OK(manager.PoolReshardRegisterRecv(ValidPlan(/*uuid=*/4122),
+                                                 std::vector<int64_t>{0}));
+  ABSL_ASSERT_OK(manager.base()->BeginIncomingPush(/*uuid=*/4122));
+  ABSL_ASSERT_OK(manager.base()->BeginIncomingPush(/*uuid=*/4122));
+
+  EXPECT_THAT(
+      manager.base()->EndIncomingPush(
+          /*uuid=*/4122, absl::DeadlineExceededError("stream 1 timeout")),
+      StatusIs(absl::StatusCode::kCancelled));
+  EXPECT_TRUE(manager.has_pool_recv(4122));
+  EXPECT_EQ(manager.base()->PoolStagingSummary()[0].free_slots, 1);
+
+  EXPECT_THAT(manager.base()->EndIncomingPush(/*uuid=*/4122, absl::OkStatus()),
+              StatusIs(absl::StatusCode::kCancelled));
+  EXPECT_FALSE(manager.has_pool_recv(4122));
+  EXPECT_EQ(manager.base()->PoolStagingSummary()[0].free_slots, 2);
+  {
+    CompleteReadResult res = manager.CompleteReadWithDetails();
+    EXPECT_THAT(res.failed, Contains("pool_reshard_req_4122"));
+    EXPECT_EQ(res.details["pool_reshard_req_4122"].code, "DEADLINE_EXCEEDED");
+  }
+}
