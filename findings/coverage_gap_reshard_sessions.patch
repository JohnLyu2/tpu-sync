+TEST(PoolReshardSendTest,
+     FinalizingSessionDuringExecutePushSettlesOrDrainsRemainingOps) {
+  constexpr int64_t kStride = 128;
+  constexpr int64_t kNumBlocks = 4;
+
+  // Keying the sender's sole schedule under shard index 1 passes Create's
+  // single-schedule fallback while failing BuildBlockRequests synchronously
+  // on shard 0 inside StartPoolPush, latching finalizing_ while ExecutePush
+  // still holds its caller op.
+  auto make_sync_push_fail_plan = [](StartTransferRequest plan) {
+    auto schedule = (*plan.mutable_shard_push_schedules())[0];
+    plan.mutable_shard_push_schedules()->erase(0);
+    (*plan.mutable_shard_push_schedules())[1] = std::move(schedule);
+    return plan;
+  };
+
+  // 1. Single pool: StartPoolPush latches finalizing_ synchronously and
+  //    ExecutePush's closing EndOp() settles the session.
+  {
+    BoundedPoolTestManager sender(/*slice_byte_size=*/kStride,
+                                  /*host_blocks=*/4,
+                                  /*physical_size=*/kStride * kNumBlocks);
+    ABSL_ASSERT_OK(sender.base()->RegisterPools({DensePool("fa", kStride)}));
+
+    StartTransferRequest plan =
+        make_sync_push_fail_plan(ValidPlan(/*uuid=*/4231));
+    ABSL_ASSERT_OK(sender.PoolReshardPush(plan, std::vector<int64_t>{0},
+                                          /*parallelism=*/1));
+    EXPECT_FALSE(sender.has_pool_send(4231));
+    EXPECT_FALSE(sender.base()->HasActivePlan(4231));
+    CompleteReadResult res = sender.CompleteReadWithDetails();
+    EXPECT_THAT(res.failed, Contains("pool_reshard_req_4231"));
+    EXPECT_EQ(res.details["pool_reshard_req_4231"].code, "NOT_FOUND");
+  }
+
+  // 2. Two pools: pool 0's StartPoolPush latches finalizing_ synchronously,
+  //    then pool 1's D2hPoolBlocks fails on the already-finalizing session;
+  //    RecordPushCompletion ignores pool 1's error and EndOp() settles with
+  //    pool 0's NOT_FOUND status.
+  {
+    BoundedPoolTestManager sender(/*slice_byte_size=*/kStride,
+                                  /*host_blocks=*/8,
+                                  /*physical_size=*/2 * kStride * kNumBlocks);
+    kv_cache::PoolSpec pool0 = DensePool("fa0", kStride);
+    kv_cache::PoolSpec pool1 = DensePool("fa1", kStride);
+    pool1.base_offset_bytes = kStride * kNumBlocks;
+    ABSL_ASSERT_OK(sender.base()->RegisterPools({pool0, pool1}));
+    sender.SetStorageDeviceSize(/*storage_idx=*/0,
+                                /*bytes=*/kStride * kNumBlocks);
+
+    StartTransferRequest plan = make_sync_push_fail_plan(
+        TwoPoolPlan(/*uuid=*/4232, /*rank_0=*/0, /*rank_1=*/0));
+    EXPECT_THAT(sender.PoolReshardPush(plan, std::vector<int64_t>{0},
+                                       /*parallelism=*/1),
+                StatusIs(absl::StatusCode::kOutOfRange));
+    EXPECT_FALSE(sender.has_pool_send(4232));
+    CompleteReadResult res = sender.CompleteReadWithDetails();
+    EXPECT_THAT(res.failed, Contains("pool_reshard_req_4232"));
+    EXPECT_EQ(res.details["pool_reshard_req_4232"].code, "NOT_FOUND");
+  }
+
+  // 3. Two storages: pool 0 pushes to HeldTcpPeer while pool 1 waits on
+  //    storage 1's bounded staging lease across a deadline sweep; waking
+  //    pool 1 fails D2hPoolBlocks on the finalizing session without settling
+  //    until pool 0's push ends.
+  {
+    HeldTcpPeer held_peer;
+    BoundedPoolTestManager sender(/*slice_byte_size=*/kStride,
+                                  /*host_blocks=*/4,
+                                  /*physical_size=*/kStride * kNumBlocks,
+                                  /*num_storages=*/2, /*timeout_s=*/0.03);
+    kv_cache::PoolSpec pool0 = DensePool("fa0", kStride);
+    pool0.storage_index = 0;
+    kv_cache::PoolSpec pool1 = DensePool("fa1", kStride);
+    pool1.storage_index = 1;
+    pool1.staging_blocks_per_request = 1;
+    ABSL_ASSERT_OK(
+        sender.base()->RegisterPools({pool0, pool1}, /*staging_leases=*/1));
+    sender.SetStorageDeviceSize(/*storage_idx=*/1, /*bytes=*/0);
+
+    ABSL_ASSERT_OK(sender.base()->AcquirePoolStagingLease(
+        /*uuid=*/9999, /*storage_idx=*/1, std::vector<int64_t>{0},
+        absl::Seconds(5)));
+    ASSERT_EQ(sender.base()->PoolStagingSummary()[1].free_slots, 0);
+
+    StartTransferRequest plan = TwoPoolPlan(
+        /*uuid=*/4233, /*rank_0=*/0, /*rank_1=*/0, held_peer.endpoint(),
+        "127.0.0.1:1");
+    absl::Status push_status;
+    std::thread push_worker([&]() {
+      push_status = sender.PoolReshardPush(plan, std::vector<int64_t>{0},
+                                           /*parallelism=*/1);
+    });
+    ASSERT_TRUE(held_peer.WaitUntilAccepted(1));
+
+    absl::SleepFor(absl::Milliseconds(45));
+    CompleteReadResult swept = sender.CompleteReadWithDetails();
+    EXPECT_THAT(swept.failed, IsEmpty());
+    EXPECT_TRUE(sender.has_pool_send(4233));
+
+    sender.base()->ReleasePoolStagingLeases(/*uuid=*/9999);
+    push_worker.join();
+    EXPECT_THAT(push_status, StatusIs(absl::StatusCode::kOutOfRange));
+    // Pool 0's push is still open, so neither the session nor storage 1's
+    // newly acquired lease settles yet.
+    EXPECT_TRUE(sender.has_pool_send(4233));
+    EXPECT_EQ(sender.base()->PoolStagingSummary()[1].free_slots, 0);
+
+    held_peer.CloseAll();
+    const absl::Time deadline = absl::Now() + absl::Seconds(5);
+    bool settled = false;
+    while (!settled && absl::Now() < deadline) {
+      CompleteReadResult res = sender.CompleteReadWithDetails();
+      if (!res.failed.empty()) {
+        EXPECT_THAT(res.failed, Contains("pool_reshard_req_4233"));
+        EXPECT_EQ(res.details["pool_reshard_req_4233"].code,
+                  "DEADLINE_EXCEEDED");
+        settled = true;
+      } else {
+        absl::SleepFor(absl::Milliseconds(5));
+      }
+    }
+    EXPECT_TRUE(settled);
+    EXPECT_FALSE(sender.has_pool_send(4233));
+    EXPECT_EQ(sender.base()->PoolStagingSummary()[1].free_slots, 1);
+  }
+}
