+TEST(ReshardSendSessionTest,
+     DuplicateCancelAndNonFinalPushCompletionKeepSessionDraining) {
+  ScopedDataConnReuseEnv env(/*value=*/nullptr);
+  KVCacheManagerWithTransfer manager = MakeTestManager();
+  manager.base()->AttachPlaceholderDeviceHoldForTest();
+  std::unique_ptr<StagingBlockAllocator> allocator =
+      CreateStagingBlockAllocator(manager.base(), /*num_slots=*/0,
+                                  /*max_blocks=*/0);
+  StartTransferRequest plan =
+      TwoPeerPlan(/*uuid=*/1214, "127.0.0.1:1", "127.0.0.1:2");
+  absl::StatusOr<std::shared_ptr<ReshardSendSession>> session =
+      ReshardSendSession::Create(
+          manager.base(), allocator.get(), std::vector<int64_t>{0},
+          /*parallelism=*/1,
+          std::chrono::steady_clock::now() + std::chrono::seconds(10), plan);
+  ABSL_ASSERT_OK(session);
+
+  ReshardSendSessionTestPeer::BeginPush(**session, manager);
+  ReshardSendSessionTestPeer::BeginPush(**session, manager);
+
+  (*session)->Finish(absl::CancelledError("first cancel"));
+  // A second Finish while finalizing neither overwrites the first error nor
+  // settles the session while pushes remain in flight.
+  (*session)->Finish(absl::DeadlineExceededError("later sweep"));
+  EXPECT_FALSE((*session)->Done());
+  EXPECT_TRUE(manager.base()->HasActivePlan(plan.uuid()));
+
+  // The first push completion on a finalizing session drops one op without
+  // settling or unregistering; the final push completion unregisters and
+  // settles with the original cancellation status.
+  ReshardSendSessionTestPeer::CompletePush(**session, manager,
+                                           absl::OkStatus());
+  EXPECT_FALSE((*session)->Done());
+  EXPECT_TRUE(manager.base()->HasActivePlan(plan.uuid()));
+
+  ReshardSendSessionTestPeer::CompletePush(**session, manager,
+                                           absl::OkStatus());
+  EXPECT_TRUE((*session)->Done());
+  EXPECT_FALSE(manager.base()->HasActivePlan(plan.uuid()));
+  EXPECT_THAT((*session)->AwaitForDone(),
+              StatusIs(absl::StatusCode::kCancelled, HasSubstr("first cancel")));
+}
