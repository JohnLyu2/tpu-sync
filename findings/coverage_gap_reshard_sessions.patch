+  plan.mutable_pool_groups(0)->set_dst_device_block_ids(0, 2);
+  auto* entry = (*plan.mutable_shard_push_schedules())[0].mutable_entries(0);
+  entry->set_dst_peer(peer);
+  entry->set_dst_block_id(2);
