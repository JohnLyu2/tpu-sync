+TEST(PoolReshardSendTest,
+     SynchronousD2hFailureSettlesOrDrainsInFlightPoolPush) {
+  constexpr int64_t kStride = 128;
+  constexpr int64_t kNumBlocks = 4;
+
+  // 1. Single pool on device_size = 0: D2hPoolBlocks fails synchronously,
+  //    settling the send immediately before PoolReshardPush returns.
+  {
+    BoundedPoolTestManager sender(/*slice_byte_size=*/kStride,
+                                  /*host_blocks=*/4,
+                                  /*physical_size=*/kStride * kNumBlocks);
+    ABSL_ASSERT_OK(sender.base()->RegisterPools({DensePool("fa", kStride)}));
+    sender.SetStorageDeviceSize(/*storage_idx=*/0, /*bytes=*/0);
+
+    EXPECT_THAT(sender.PoolReshardPush(ValidPlan(/*uuid=*/4221),
+                                       std::vector<int64_t>{0},
+                                       /*parallelism=*/1),
+                StatusIs(absl::StatusCode::kOutOfRange));
+    EXPECT_FALSE(sender.has_pool_send(4221));
+    EXPECT_FALSE(sender.base()->HasActivePlan(4221));
+    CompleteReadResult res = sender.CompleteReadWithDetails();
+    EXPECT_THAT(res.failed, Contains("pool_reshard_req_4221"));
+    EXPECT_EQ(res.details["pool_reshard_req_4221"].code, "OUT_OF_RANGE");
+  }
+
+  // 2. Two pools where pool 0 starts an in-flight push to HeldTcpPeer and
+  //    pool 1 fails D2hPoolBlocks synchronously: the send latches pool 1's
+  //    error and stays active until pool 0's push finishes.
+  {
+    HeldTcpPeer held_peer;
+    BoundedPoolTestManager sender(/*slice_byte_size=*/kStride,
+                                  /*host_blocks=*/8,
+                                  /*physical_size=*/2 * kStride * kNumBlocks);
+    kv_cache::PoolSpec pool0 = DensePool("fa0", kStride);
+    kv_cache::PoolSpec pool1 = DensePool("fa1", kStride);
+    pool1.base_offset_bytes = kStride * kNumBlocks;
+    ABSL_ASSERT_OK(sender.base()->RegisterPools({pool0, pool1}));
+    sender.SetStorageDeviceSize(/*storage_idx=*/0,
+                                /*bytes=*/kStride * kNumBlocks);
+
+    StartTransferRequest plan = TwoPoolPlan(
+        /*uuid=*/4222, /*rank_0=*/0, /*rank_1=*/0, held_peer.endpoint(),
+        "127.0.0.1:1");
+    EXPECT_THAT(sender.PoolReshardPush(plan, std::vector<int64_t>{0},
+                                       /*parallelism=*/1),
+                StatusIs(absl::StatusCode::kOutOfRange));
+    ASSERT_TRUE(held_peer.WaitUntilAccepted(1));
+    EXPECT_TRUE(sender.has_pool_send(4222));
+
+    held_peer.CloseAll();
+    const absl::Time deadline = absl::Now() + absl::Seconds(5);
+    bool settled = false;
+    while (!settled && absl::Now() < deadline) {
+      CompleteReadResult res = sender.CompleteReadWithDetails();
+      if (!res.failed.empty()) {
+        EXPECT_THAT(res.failed, Contains("pool_reshard_req_4222"));
+        EXPECT_EQ(res.details["pool_reshard_req_4222"].code, "OUT_OF_RANGE");
+        settled = true;
+      } else {
+        absl::SleepFor(absl::Milliseconds(5));
+      }
+    }
+    EXPECT_TRUE(settled);
+    EXPECT_FALSE(sender.has_pool_send(4222));
+  }
+}
