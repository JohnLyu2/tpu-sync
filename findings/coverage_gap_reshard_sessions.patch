+// Loopback TCP listener that accepts incoming push connections and holds them
+// open without replying until CloseAll(), keeping SocketTransportAdapter pushes
+// deterministically in flight.
+class HeldTcpPeer {
+ public:
+  HeldTcpPeer() {
+    fd_ = socket(AF_INET, SOCK_STREAM, 0);
+    sockaddr_in addr{};
+    addr.sin_family = AF_INET;
+    addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    addr.sin_port = 0;
+    EXPECT_EQ(bind(fd_, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)), 0);
+    socklen_t len = sizeof(addr);
+    EXPECT_EQ(getsockname(fd_, reinterpret_cast<sockaddr*>(&addr), &len), 0);
+    port_ = ntohs(addr.sin_port);
+    EXPECT_EQ(listen(fd_, 16), 0);
+    accept_thread_ = std::thread([this]() {
+      while (true) {
+        int client = accept(fd_, nullptr, nullptr);
+        if (client < 0) return;
+        {
+          std::lock_guard<std::mutex> lock(mu_);
+          if (closed_) {
+            shutdown(client, SHUT_RDWR);
+            close(client);
+            return;
+          }
+          clients_.push_back(client);
+        }
+        cv_.notify_all();
+      }
+    });
+  }
+
+  ~HeldTcpPeer() { CloseAll(); }
+
+  std::string endpoint() const {
+    return "127.0.0.1:" + std::to_string(port_);
+  }
+
+  bool WaitUntilAccepted(size_t count) {
+    std::unique_lock<std::mutex> lock(mu_);
+    return cv_.wait_for(lock, std::chrono::seconds(5), [this, count]() {
+             return clients_.size() >= count || closed_;
+           }) &&
+           clients_.size() >= count;
+  }
+
+  void CloseAll() {
+    std::vector<int> to_close;
+    int listen_fd = -1;
+    {
+      std::lock_guard<std::mutex> lock(mu_);
+      if (closed_) return;
+      closed_ = true;
+      to_close.swap(clients_);
+      listen_fd = fd_;
+      fd_ = -1;
+    }
+    for (int client : to_close) {
+      shutdown(client, SHUT_RDWR);
+      close(client);
+    }
+    if (listen_fd >= 0) {
+      shutdown(listen_fd, SHUT_RDWR);
+      close(listen_fd);
+    }
+    cv_.notify_all();
+    if (accept_thread_.joinable()) {
+      accept_thread_.join();
+    }
+  }
+
+ private:
+  int fd_ = -1;
+  int port_ = 0;
+  std::mutex mu_;
+  std::condition_variable cv_;
+  std::vector<int> clients_;
+  bool closed_ = false;
+  std::thread accept_thread_;
+};
