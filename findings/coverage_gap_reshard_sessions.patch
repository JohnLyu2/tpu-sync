+
+  const absl::Time deadline = absl::Now() + absl::Seconds(5);
+  bool sender_done = false;
+  bool receiver_done = false;
+  while ((!sender_done || !receiver_done) && absl::Now() < deadline) {
+    if (!sender_done) {
+      const auto [sent, received, failed] = sender.CompleteReadRaw();
+      EXPECT_THAT(failed, IsEmpty());
+      if (!sent.empty()) {
+        EXPECT_THAT(sent, Contains("pool_reshard_req_4201"));
+        sender_done = true;
+      }
+    }
+    if (!receiver_done) {
+      const auto [sent, received, failed] = receiver.CompleteReadRaw();
+      EXPECT_THAT(failed, IsEmpty());
+      if (!received.empty()) {
+        EXPECT_THAT(received, Contains("pool_reshard_req_4201"));
+        receiver_done = true;
+      }
+    }
+    if (!sender_done || !receiver_done) {
+      absl::SleepFor(absl::Milliseconds(5));
+    }
+  }
+  ASSERT_TRUE(sender_done);
+  ASSERT_TRUE(receiver_done);
+  EXPECT_FALSE(sender.base()->HasActivePlan(4201));
+  EXPECT_FALSE(receiver.base()->HasActivePlan(4201));
+  EXPECT_EQ(receiver.base()->PoolStagingSummary()[0].free_slots, 2);
+  // Bounded staging leased one of the two arena slots on storage 0; the 16-byte
+  // 0xA5 payload landed in that slot before H2D completed.
+  const uint8_t* recv_base = receiver.base()->GetHostPointer(0, 0);
+  EXPECT_TRUE(recv_base[0] == 0xA5 || recv_base[kStride] == 0xA5);
+}
