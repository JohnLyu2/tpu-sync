+// The copy's future is already failed when StartPush registers on it: the
+// StartPush callback ends its op at registration, then SendNextLayer's
+// callback sees the failure (kD2hPhase) and the send settles failed.
+TEST(TransferSendSessionTest, CopyAlreadyFailedAtDispatchFailsTheSend) {
+  FailingD2hSendBase base(/*num_layers=*/1, /*host_blocks=*/4);
+  base.FailAllFuturesAtDispatch();
+  std::unique_ptr<StagingBlockAllocator> allocator =
+      CreateStagingBlockAllocator(&base, /*num_slots=*/2, /*max_blocks=*/1);
+  const auto now = std::chrono::steady_clock::now();
+  std::shared_ptr<TransferSendSession> session = *TransferSendSession::Create(
+      &base, allocator.get(), "req_future_failed", /*uuid=*/403,
+      /*block_ids=*/{0}, /*deadline=*/now + std::chrono::seconds(10),
+      /*register_start=*/now);
+  session->ValidateAndBeginPull({0}, now);
+  session->StartPush({"127.0.0.1:9000"}, /*src_block_ids=*/{0},
+                     /*dst_block_ids=*/{0});
+
+  EXPECT_THAT(session->AwaitForDone(), StatusIs(absl::StatusCode::kInternal));
+  EXPECT_FALSE(session->HasStaging());
+  EXPECT_EQ(base.h2h_calls(), 0);
+  EXPECT_EQ(allocator->num_free_slots(), 2);
+}
+
+// The only push fails: FinishLocked(status, kPushPhase) in the push callback,
+// the send settles failed, staging released.
+TEST(TransferSendSessionTest, FailedPushFailsTheSend) {
+  FakeSendBase base(/*num_layers=*/1, /*host_blocks=*/4);
+  base.SetManualH2h(true);
+  std::unique_ptr<StagingBlockAllocator> allocator =
+      CreateStagingBlockAllocator(&base, /*num_slots=*/2, /*max_blocks=*/1);
+  const auto now = std::chrono::steady_clock::now();
+  std::shared_ptr<TransferSendSession> session = *TransferSendSession::Create(
+      &base, allocator.get(), "req_push_fail", /*uuid=*/404, /*block_ids=*/{0},
+      /*deadline=*/now + std::chrono::seconds(10), /*register_start=*/now);
+  session->ValidateAndBeginPull({0}, now);
+  session->StartPush({"127.0.0.1:9000"}, /*src_block_ids=*/{0},
+                     /*dst_block_ids=*/{0});
+  ASSERT_TRUE(base.WaitForH2hCalls(1, absl::Seconds(2)));
+  EXPECT_FALSE(session->Done());
+
+  base.CompleteH2h(0, absl::UnavailableError("peer went away"));
+  EXPECT_THAT(session->AwaitForDone(),
+              StatusIs(absl::StatusCode::kUnavailable));
+  EXPECT_FALSE(session->HasStaging());
+  EXPECT_EQ(allocator->num_free_slots(), 2);
+}
