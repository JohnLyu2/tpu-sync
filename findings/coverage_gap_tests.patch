diff --git a/tpu_sync/core/controller/read_remote_deadline_test.cc b/tpu_sync/core/controller/read_remote_deadline_test.cc
new file mode 100644
index 0000000..455b9c5
--- /dev/null
+++ b/tpu_sync/core/controller/read_remote_deadline_test.cc
@@ -0,0 +1,219 @@
+// Copyright 2026 Google LLC.
