+// RaidenController::ReadRemote with a short destination deadline.
+//
+// RemoteReadDeadline() reads RAIDEN_REMOTE_READ_DEADLINE_S once per process
+// and defaults to the lease TTL plus 30 s, so the deadline thread never fires
+// inside raiden_controller_test. This binary runs with the variable set to 1
+// (see its cc_test rule) and exercises the three lifecycle branches that
+// depend on it: the deadline settling an unanswered read, an acquire reply
+// landing after the deadline, and a pull completing after the deadline.
+
+#include <atomic>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include <gtest/gtest.h>
+#include "absl/status/status.h"
+#include "absl/status/statusor.h"
+#include "absl/time/clock.h"
+#include "absl/time/time.h"
+#include "absl/types/span.h"
+#include "xla/tsl/platform/statusor.h"
+#include "tpu_sync/core/controller/controller_client.h"
+#include "tpu_sync/core/controller/controller_server.h"
+#include "tpu_sync/core/controller/raiden_controller.h"
+#include "tpu_sync/core/controller/test_util.h"
+#include "tpu_sync/core/kv_manager_holder.h"
+#include "tpu_sync/core/raiden_transfer_endpoint.h"
+#include "tpu_sync/rpc/raiden_service.pb.h"
+
+namespace tpu_raiden {
+namespace controller {
+namespace {
+
+class ReadRemoteDeadlineTest : public ::testing::Test {
+ protected:
+  void SetUp() override {
+    worker_ = CreateTestWorkerServer();
+    unit_.set_job_name("test_job");
+    unit_.set_job_replica_id("0");
+    unit_.set_data_name("test_data");
+    src_ = core::controller::CreateTestControllerServer();
+    ASSERT_TRUE(src_->client
+                    ->RegisterWorker("src_worker_0", "src_worker_0_addr",
+                                     {::tpu_raiden::RaidenTransferEndpoint{
+                                         "src_ep:1", {0, 1}}},
+                                     /*node_id=*/0)
+                    .ok());
+  }
+
+  void TearDown() override {
+    if (worker_ != nullptr) {
+      worker_->service->SetTransferManager(KVManagerHolder(nullptr));
+    }
+    if (src_ != nullptr) src_->service->ClearReadRemoteHooks();
+  }
+
+  void Register(RaidenController& c) {
+    core::controller::RaidenControllerClient client(c.controller_address());
+    auto st = client.RegisterWorker(
+        "worker_0", worker_->server_address,
+        {::tpu_raiden::RaidenTransferEndpoint{worker_->server_address, {}}},
+        /*node_id=*/0);
+    ASSERT_TRUE(st.ok()) << st.message();
+  }
+
+  // The source validates (taking `validate_delay`) and pins on the main path;
+  // `pins_` counts outstanding pins from the moment the acquire reaches the
+  // source so the tests can wait for the grant to land and be released.
+  void SetSourceHooks(absl::Duration validate_delay,
+                      absl::Status validate_status = absl::OkStatus()) {
+    src_->service->SetReadRemoteHooks(
+        [this, validate_delay, validate_status](absl::Span<const std::string> h)
+            -> absl::StatusOr<std::vector<int32_t>> {
+          if (validate_status.ok()) {
+            pins_ += static_cast<int>(h.size());
+          }
+          absl::SleepFor(validate_delay);
+          if (!validate_status.ok()) return validate_status;
+          return std::vector<int32_t>(h.size(), 42);
+        },
+        [this](absl::Span<const std::string> h) {
+          pins_ -= static_cast<int>(h.size());
+        });
+  }
+
+  bool WaitForNoPins(absl::Duration timeout) {
+    const absl::Time deadline = absl::Now() + timeout;
+    while (pins_.load() != 0 && absl::Now() < deadline) {
+      absl::SleepFor(absl::Milliseconds(10));
+    }
+    return pins_.load() == 0;
+  }
+
+  ::tpu_sync::rpc::RaidenIdProto unit_;
+  std::unique_ptr<TestWorkerServer> worker_;
+  // Declared before src_: the service's teardown may still call the unpin hook.
+  std::atomic<int> pins_{0};
+  std::unique_ptr<core::controller::TestControllerServer> src_;
+};
+
+// The source does not answer in time: the deadline thread settles the read
+// with DeadlineExceeded about one second in; the acquire reply (an OK lease)
+// lands later and is released, leaving no pins.
+TEST_F(ReadRemoteDeadlineTest, UnansweredAcquireSettlesAtTheDeadline) {
+  ShardAwareMockTransferManager mock;
+  worker_->service->SetTransferManager(KVManagerHolder(&mock));
+  SetSourceHooks(/*validate_delay=*/absl::Milliseconds(2500));
+
+  TF_ASSERT_OK_AND_ASSIGN(
+      auto dest, RaidenController::Create(unit_, /*num_blocks=*/5,
+                                          /*num_shards=*/2,
+                                          /*shard_size_bytes=*/512,
+                                          /*raiden_controller_address=*/""));
+  Register(*dest);
+
+  const absl::Time start = absl::Now();
+  absl::Status st = dest->ReadRemote(src_->server_address, {10},
+                                     /*dst_host_block_ids=*/{20}, {"h0"})
+                        .Await();
+  EXPECT_EQ(st.code(), absl::StatusCode::kDeadlineExceeded) << st;
+  EXPECT_LT(absl::Now() - start, absl::Seconds(2));
+  EXPECT_GT(pins_.load(), 0);  // the acquire is still at the source
+
+  // The grant lands at ~2.5 s and is released after the post-deadline path
+  // completes.
+  EXPECT_TRUE(WaitForNoPins(absl::Seconds(5)));
+}
+
+// The acquire fails at the source, but only after the deadline has settled
+// the read: the late failure changes nothing the caller sees and starts no
+// read on the worker.
+TEST_F(ReadRemoteDeadlineTest, LateAcquireFailureAfterTheDeadlineIsAbsorbed) {
+  ShardAwareMockTransferManager mock;
+  worker_->service->SetTransferManager(KVManagerHolder(&mock));
+  SetSourceHooks(/*validate_delay=*/absl::Milliseconds(2500),
+                 absl::NotFoundError("gone"));
+
+  TF_ASSERT_OK_AND_ASSIGN(
+      auto dest, RaidenController::Create(unit_, /*num_blocks=*/5,
+                                          /*num_shards=*/2,
+                                          /*shard_size_bytes=*/512,
+                                          /*raiden_controller_address=*/""));
+  Register(*dest);
+
+  absl::Status st = dest->ReadRemote(src_->server_address, {10},
+                                     /*dst_host_block_ids=*/{20}, {"h0"})
+                        .Await();
+  EXPECT_EQ(st.code(), absl::StatusCode::kDeadlineExceeded) << st;
+  absl::SleepFor(absl::Seconds(3));  // the NotFound reply lands at ~2.5 s
+  EXPECT_EQ(mock.vector_h2h_read_calls + mock.h2h_read_calls, 0);
+}
+
+// A transfer manager whose remote read takes `read_duration`.
+struct SlowReadMock : ShardAwareMockTransferManager {
+  using ShardAwareMockTransferManager::H2dRead;
+  using ShardAwareMockTransferManager::H2hRead;
+  using ShardAwareMockTransferManager::H2hWrite;
+
+  absl::Duration read_duration = absl::Seconds(3);
+  std::atomic<int64_t> read_finished_ns{0};
+
+  absl::StatusOr<raiden::PjRtCopyFuture> H2hReadExplicit(
+      const std::vector<::tpu_raiden::RaidenTransferEndpoint>&
+          remote_descriptors,
+      const std::vector<int>& src_block_ids,
+      const std::vector<int>& dst_block_ids) {
+    absl::SleepFor(read_duration);
+    auto result = ShardAwareMockTransferManager::H2hReadExplicit(
+        remote_descriptors, src_block_ids, dst_block_ids);
+    read_finished_ns = absl::ToUnixNanos(absl::Now());
+    return result;
+  }
+};
+
+// The worker's read outlasts the deadline: the deadline thread settles the
+// read with DeadlineExceeded and sends an early lease release while the pull
+// runs, and when the pull completes afterwards its commit-phase release and
+// Settle(OK) run against the already-settled state.
+TEST_F(ReadRemoteDeadlineTest, PullCompletingAfterTheDeadlineReleasesTheLease) {
+  SlowReadMock mock;
+  worker_->service->SetTransferManager(KVManagerHolder(&mock));
+  SetSourceHooks(/*validate_delay=*/absl::ZeroDuration());
+
+  TF_ASSERT_OK_AND_ASSIGN(
+      auto dest, RaidenController::Create(unit_, /*num_blocks=*/5,
+                                          /*num_shards=*/2,
+                                          /*shard_size_bytes=*/512,
+                                          /*raiden_controller_address=*/""));
+  Register(*dest);
+
+  absl::Status st = dest->ReadRemote(src_->server_address, {10},
+                                     /*dst_host_block_ids=*/{20}, {"h0"})
+                        .Await();
+  const absl::Time settled_at = absl::Now();
+  EXPECT_EQ(st.code(), absl::StatusCode::kDeadlineExceeded) << st;
+  EXPECT_EQ(mock.read_finished_ns.load(), 0) << "pull already done at settle";
+
+  const absl::Time pull_deadline = absl::Now() + absl::Seconds(10);
+  while (mock.read_finished_ns.load() == 0 && absl::Now() < pull_deadline) {
+    absl::SleepFor(absl::Milliseconds(20));
+  }
+  EXPECT_GT(mock.read_finished_ns.load(), absl::ToUnixNanos(settled_at));
+  EXPECT_TRUE(WaitForNoPins(absl::Seconds(2)));
+  // Detach before `mock` leaves scope; SetTransferManager takes the worker's
+  // RPC mutex, waiting out any in-flight TransferBuffers call.
+  worker_->service->SetTransferManager(KVManagerHolder(nullptr));
+}
+
+}  // namespace
+}  // namespace controller
+}  // namespace tpu_raiden
diff --git a/tpu_sync/kv_cache/kv_cache_manager_with_transfer_send_drain_test.cc b/tpu_sync/kv_cache/kv_cache_manager_with_transfer_send_drain_test.cc
index 331de88..0df7c1e 100644
--- a/tpu_sync/kv_cache/kv_cache_manager_with_transfer_send_drain_test.cc
+++ b/tpu_sync/kv_cache/kv_cache_manager_with_transfer_send_drain_test.cc
@@ -1733,5 +1733,91 @@ TEST(SendLifecycleTest,
   EXPECT_EQ(producer.free_slots(), kSlots);
   EXPECT_FALSE(producer.has_send(404));
 }
+
+// ExecuteLayerH2d: H2dSyncDispatch fails. The receive finishes with the
+// dispatch error in the h2d phase, releases the op it took and settles at
+// once, since no copy was issued; the poll reports it failed.
+TEST(RecvLifecycleTest, FailedH2dDispatchFailsAndSettlesTheReceive) {
+  GetFaultInjector().Reset();
+  absl::Cleanup reset_faults = [] { GetFaultInjector().Reset(); };
+  FaultInjectionRule failed_dispatch;
+  failed_dispatch.hook = std::string(hooks::kTransferRecvSessionH2dDispatch);
+  failed_dispatch.probability = 1.0;
+  ABSL_ASSERT_OK(GetFaultInjector().Install({failed_dispatch}));
+
+  RecvTestManager consumer(/*num_layers=*/1);
+  consumer.AddRecv("req", /*uuid=*/501);
+  EXPECT_FALSE(consumer.ReceiveLayer(/*layer=*/0, /*uuid=*/501).ok());
+  EXPECT_EQ(consumer.copies_issued(), 0);
+  EXPECT_EQ(consumer.free_slots(), kSlots);
+
+  CompleteReadResult completions = consumer.CompleteReadWithDetails();
+  EXPECT_THAT(completions.received, IsEmpty());
+  EXPECT_THAT(completions.failed, ElementsAre("req"));
+  EXPECT_EQ(completions.details["req"].phase, "h2d");
+  EXPECT_FALSE(consumer.has_recv(501));
+}
+
+// A second Finish(error) on a draining receive changes nothing: the first
+// error is the one reported, once, when the copy ends.
+TEST(RecvLifecycleTest, SecondFinishOnAFailedReceiveIsANoOp) {
+  RecvTestManager consumer(/*num_layers=*/1, /*timeout_s=*/10.0);
+  consumer.AddRecv("req", /*uuid=*/502);
+  ABSL_ASSERT_OK(consumer.ReceiveLayer(/*layer=*/0, /*uuid=*/502));
+  consumer.FailRecv(/*uuid=*/502, absl::InternalError("first"));
+  consumer.FailRecv(/*uuid=*/502, absl::UnavailableError("second"));
+  EXPECT_TRUE(consumer.has_recv(502));
+  EXPECT_EQ(consumer.free_slots(), kSlots - 1);
+
+  consumer.FinishCopy(0, absl::OkStatus());
+  CompleteReadResult completions = consumer.CompleteReadWithDetails();
+  EXPECT_THAT(completions.failed, ElementsAre("req"));
+  EXPECT_EQ(completions.details["req"].code, "INTERNAL");
+  EXPECT_EQ(completions.details["req"].reason, "first");
+  EXPECT_EQ(consumer.free_slots(), kSlots);
+  EXPECT_THAT(consumer.CompleteReadWithDetails().failed, IsEmpty());
+}
+
+// An incoming push lease that closes while the layer's copy is still
+// running, the usual order for an asynchronous H2D: the lease release
+// neither settles the receive nor returns its staging; the copy's
+// completion does.
+TEST(RecvLifecycleTest, PushLeaseClosingBeforeTheCopyEndsDoesNotSettle) {
+  RecvTestManager consumer(/*num_layers=*/1, /*timeout_s=*/10.0);
+  consumer.AddRecv("req", /*uuid=*/503);
+  ABSL_ASSERT_OK(consumer.base()->BeginIncomingPush(/*uuid=*/503));
+  ABSL_ASSERT_OK(consumer.ReceiveLayer(/*layer=*/0, /*uuid=*/503));
+  ABSL_ASSERT_OK(consumer.ReceiveBlocks({0}, /*uuid=*/503));
+  ABSL_ASSERT_OK(consumer.base()->EndIncomingPush(/*uuid=*/503));
+
+  Reports during = consumer.CompleteReadRaw();
+  EXPECT_THAT(DoneReceiving(during), IsEmpty());
+  EXPECT_TRUE(consumer.has_recv(503));
+  EXPECT_EQ(consumer.free_slots(), kSlots - 1);
+
+  consumer.FinishCopy(0, absl::OkStatus());
+  Reports after = consumer.CompleteReadRaw();
+  EXPECT_THAT(DoneReceiving(after), ElementsAre("req"));
+  EXPECT_EQ(consumer.free_slots(), kSlots);
+}
+
+// A cancelled receive whose only copy then fails keeps the cancellation: the
+// copy's error is absorbed by the draining receive, its callback ends the
+// last op, and the receive settles and is reported failed once.
+TEST(RecvDrainTest, CancelledReceiveWhoseCopyThenFailsStaysCancelled) {
+  RecvTestManager consumer(/*num_layers=*/1, /*timeout_s=*/10.0);
+  consumer.AddRecv("req", /*uuid=*/504);
+  ABSL_ASSERT_OK(consumer.ReceiveLayer(/*layer=*/0, /*uuid=*/504));
+  consumer.FailRecv(/*uuid=*/504, absl::CancelledError("cancel"));
+  EXPECT_EQ(consumer.free_slots(), kSlots - 1);
+
+  consumer.FinishCopy(0, absl::InternalError("copy failed"));
+  EXPECT_EQ(consumer.free_slots(), kSlots);
+  CompleteReadResult completions = consumer.CompleteReadWithDetails();
+  EXPECT_THAT(completions.failed, ElementsAre("req"));
+  EXPECT_EQ(completions.details["req"].code, "CANCELLED");
+  EXPECT_THAT(consumer.CompleteReadWithDetails().failed, IsEmpty());
+}
+
 }  // namespace
 }  // namespace tpu_raiden
diff --git a/tpu_sync/kv_cache/transfer_send_session_test.cc b/tpu_sync/kv_cache/transfer_send_session_test.cc
index d4d6dc6..a5d5ca2 100644
--- a/tpu_sync/kv_cache/transfer_send_session_test.cc
+++ b/tpu_sync/kv_cache/transfer_send_session_test.cc
@@ -796,5 +796,61 @@ TEST(TransferSendSessionTest,
   EXPECT_EQ(allocator->num_free_slots(), 2);
 }
 
+// The first layer's D2H dispatch fails, so no copy is ever issued: the
+// dispatch error fails the send, `fail_unissued_layers` resolves layer 0's
+// promise with it, and the H2H chain's own callback on that promise releases
+// the last op. The send settles inside StartPush with nothing in flight.
+TEST(TransferSendSessionTest, FailedD2hDispatchOnFirstLayerSettlesAtOnce) {
+  FakeSendBase base(/*num_layers=*/1, /*host_blocks=*/4);
+  base.FailD2hDispatchAtLayer(/*layer_idx=*/0,
+                              absl::InternalError("dispatch refused"));
+  std::unique_ptr<StagingBlockAllocator> allocator =
+      CreateStagingBlockAllocator(&base, /*num_slots=*/2, /*max_blocks=*/1);
+  const auto now = std::chrono::steady_clock::now();
+  std::shared_ptr<TransferSendSession> session = *TransferSendSession::Create(
+      &base, allocator.get(), "req_first_dispatch_fail", /*uuid=*/309,
+      /*block_ids=*/{0}, /*deadline=*/now + std::chrono::seconds(10),
+      /*register_start=*/now);
+  session->ValidateAndBeginPull({0}, now);
+  session->StartPush({"127.0.0.1:9000"}, /*src_block_ids=*/{0},
+                     /*dst_block_ids=*/{0});
+
+  EXPECT_EQ(base.d2h_calls(), 1);
+  EXPECT_THAT(session->AwaitForDone(), StatusIs(absl::StatusCode::kInternal));
+  EXPECT_TRUE(session->Done());
+  EXPECT_FALSE(session->HasStaging());
+  EXPECT_EQ(base.h2h_calls(), 0);
+  EXPECT_EQ(allocator->num_free_slots(), 2);
+}
+
+// A send cancelled while its push is in flight keeps the cancellation when
+// the push then fails: FinishLocked is first-Finish-wins, so the push
+// callback's error does not replace the status already decided, and the
+// failed push's op is what settles the send.
+TEST(TransferSendSessionTest, CancelledSendWhosePushThenFailsKeepsCancelled) {
+  FakeSendBase base(/*num_layers=*/1, /*host_blocks=*/4);
+  base.SetManualH2h(true);
+  std::unique_ptr<StagingBlockAllocator> allocator =
+      CreateStagingBlockAllocator(&base, /*num_slots=*/2, /*max_blocks=*/1);
+  const auto now = std::chrono::steady_clock::now();
+  std::shared_ptr<TransferSendSession> session = *TransferSendSession::Create(
+      &base, allocator.get(), "req_cancel_then_push_fail", /*uuid=*/310,
+      /*block_ids=*/{0}, /*deadline=*/now + std::chrono::seconds(10),
+      /*register_start=*/now);
+  session->ValidateAndBeginPull({0}, now);
+  session->StartPush({"127.0.0.1:9000"}, /*src_block_ids=*/{0},
+                     /*dst_block_ids=*/{0});
+  ASSERT_TRUE(base.WaitForH2hCalls(1, absl::Seconds(2)));
+
+  session->Finish(absl::CancelledError("consumer cancelled"));
+  EXPECT_TRUE(session->IsDraining());
+  EXPECT_FALSE(session->Done());
+
+  base.CompleteH2h(0, absl::InternalError("push failed"));
+  EXPECT_THAT(session->AwaitForDone(), StatusIs(absl::StatusCode::kCancelled));
+  EXPECT_FALSE(session->HasStaging());
+  EXPECT_EQ(allocator->num_free_slots(), 2);
+}
+
 }  // namespace
 }  // namespace tpu_raiden
