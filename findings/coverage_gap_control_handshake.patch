+// Rendezvous across every worker in `manager`'s handshake pool so any
+// previously running handshake callback has finished before the caller returns.
+void DrainPushPool(TestManager& manager) {
+  NumaThreadPool* pool = manager.base()->push_pool().get();
+  ASSERT_NE(pool, nullptr);
+  const size_t n = pool->num_threads();
+  std::mutex mu;
+  std::condition_variable cv;
+  size_t arrived = 0;
+  std::vector<std::future<void>> barrier;
+  barrier.reserve(n);
+  for (size_t i = 0; i < n; ++i) {
+    barrier.push_back(pool->Schedule([&] {
+      std::unique_lock<std::mutex> lock(mu);
+      if (++arrived == n) {
+        cv.notify_all();
+      } else {
+        cv.wait(lock, [&] { return arrived == n; });
+      }
+    }));
+  }
+  for (std::future<void>& f : barrier) {
+    f.get();
+  }
+}
