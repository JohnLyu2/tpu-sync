+TEST_F(ReshardStackTest,
+       TwoDestinationsSecondArmFailureAbandonsClaimAndSkipsSenders) {
+  using ProtoStatus = tpu_sync::rpc::GetRequestBlockStatusResponse;
+  RegisterAllUnits(/*num_src=*/2, /*live=*/1024, /*stride=*/1024,
+                   /*num_blocks=*/16, /*num_dst=*/2);
+  RegisterSpans(0, "req-arm2-fail", 90, 1024, 3, 0, 0, 1024);
+  RegisterSpans(1, "req-arm2-fail", 90, 1024, 5, 1, 0, 512);
+
+  // Hold destination 1 (10.0.0.2:9601) until destination 0 (10.0.0.2:9600) has
+  // armed, then fail destination 1 so armFail fires with an armed peer live.
+  absl::Notification release_dst1;
+  absl::Cleanup notify_on_exit = [&release_dst1] {
+    if (!release_dst1.HasBeenNotified()) release_dst1.Notify();
+  };
+  transport_.FailFor("10.0.0.2:9601");
+  transport_.HoldAfterCalls("10.0.0.2:9601", /*after_calls=*/0, &release_dst1);
+  tpu_sync::rpc::ControllerResponse resp;
+  std::thread coord([&] {
+    resp = Coordinate("req-arm2-fail", 90, 2, {7, 9}, /*dst_skip=*/{},
+                      /*num_dst=*/2);
+  });
+  transport_.WaitForCompletedCalls("10.0.0.2:9600", 1);
+  release_dst1.Notify();
+  coord.join();
+  ASSERT_FALSE(resp.success());
+  EXPECT_THAT(resp.message(), HasSubstr("injected arm refusal"));
+
+  ASSERT_EQ(transport_.calls_.size(), 2u);
+  std::multiset<std::string> arm_endpoints = {transport_.calls_[0].first,
+                                              transport_.calls_[1].first};
+  EXPECT_EQ(arm_endpoints,
+            (std::multiset<std::string>{"10.0.0.2:9600", "10.0.0.2:9601"}));
+  EXPECT_FALSE(WorkerStartTransfer(0).is_sender());
+  EXPECT_FALSE(WorkerStartTransfer(1).is_sender());
+  EXPECT_EQ(RequestBlockStatuses("req-arm2-fail", 90),
+            std::vector<int>{ProtoStatus::STATUS_REGISTERED});
+
+  transport_.HoldAfterCalls("", 0, nullptr);
+  transport_.FailFor("");
+  transport_.calls_.clear();
+  tpu_sync::rpc::ControllerResponse retry =
+      Coordinate("req-arm2-fail", 90, 2, {7, 9}, /*dst_skip=*/{}, /*num_dst=*/2);
+  ASSERT_TRUE(retry.success()) << retry.message();
+  EXPECT_EQ(transport_.calls_.size(), 4u);
+}
