diff --git a/tpu_sync/kv_cache/transfer_send_session_test.cc b/tpu_sync/kv_cache/transfer_send_session_test.cc
index 9dd8af3..fa9114b 100644
--- a/tpu_sync/kv_cache/transfer_send_session_test.cc
+++ b/tpu_sync/kv_cache/transfer_send_session_test.cc
@@ -480,5 +480,92 @@ TEST(TransferSendSessionTest, ReleaseStagingBlocksClearsD2hLayerFuturesOnDone) {
       session->OwnsBlockWithReadyFuture(/*block_id=*/0, /*layer_idx=*/0));
 }
 
+// Per-peer admission on the shared staging pool: a peer at its cap is refused
+// while slots are still free, other peers are unaffected, and a release
+// restores headroom. This is the staging-slot half of cross-peer isolation
+// (see DISABLED_SickPeerStarvesStagingSlotsForHealthyPeer in
+// kv_cache_manager_with_transfer_control_test.cc).
+TEST(StagingBlockAllocatorTest, PerPeerCapRefusesOnlyThePeerAtCap) {
+  FakeSendBase base(/*num_layers=*/1, /*host_blocks=*/4);
+  std::unique_ptr<StagingBlockAllocator> allocator =
+      StagingBlockAllocator::Create(&base, /*num_slots=*/4, /*max_blocks=*/1,
+                                    /*dynamic_host_staging=*/false,
+                                    /*max_staged_reads_per_peer=*/2);
+  ASSERT_EQ(allocator->max_staged_reads_per_peer(), 2);
+
+  absl::StatusOr<StagingAllocation> sick0 = allocator->Acquire(1, "sick");
+  absl::StatusOr<StagingAllocation> sick1 = allocator->Acquire(1, "sick");
+  ABSL_ASSERT_OK(sick0);
+  ABSL_ASSERT_OK(sick1);
+  EXPECT_EQ(allocator->num_held_by_peer("sick"), 2);
+  EXPECT_EQ(allocator->num_free_slots(), 2u);
+
+  // Third read from the same peer: refused although two slots are free.
+  EXPECT_THAT(allocator->Acquire(1, "sick"),
+              StatusIs(absl::StatusCode::kResourceExhausted));
+  EXPECT_EQ(allocator->num_free_slots(), 2u)
+      << "a refused acquisition must not consume a slot";
+  EXPECT_EQ(allocator->num_held_by_peer("sick"), 2)
+      << "a refused acquisition must not be charged";
+
+  // Another peer is admitted from the slots the capped peer could not take.
+  absl::StatusOr<StagingAllocation> healthy0 = allocator->Acquire(1, "healthy");
+  ABSL_ASSERT_OK(healthy0);
+  EXPECT_EQ(allocator->num_held_by_peer("healthy"), 1);
+  EXPECT_EQ(allocator->num_free_slots(), 1u);
+
+  // Keyless acquisitions (the send side) are never capped.
+  absl::StatusOr<StagingAllocation> keyless = allocator->Acquire(1);
+  ABSL_ASSERT_OK(keyless);
+  EXPECT_EQ(allocator->num_free_slots(), 0u);
+  keyless->Reset();
+  EXPECT_EQ(allocator->num_free_slots(), 1u);
+
+  // Releasing one of the capped peer's allocations restores its headroom; the
+  // charge is dropped in the same step as the slot.
+  sick0->Reset();
+  EXPECT_EQ(allocator->num_held_by_peer("sick"), 1);
+  EXPECT_EQ(allocator->num_free_slots(), 2u);
+  absl::StatusOr<StagingAllocation> sick2 = allocator->Acquire(1, "sick");
+  ABSL_ASSERT_OK(sick2);
+  EXPECT_EQ(allocator->num_held_by_peer("sick"), 2);
+
+  // Moving the handle moves the charge with it; destroying the moved-to
+  // handle releases it exactly once.
+  {
+    StagingAllocation moved = *std::move(sick1);
+    EXPECT_EQ(moved.peer_key(), "sick");
+    EXPECT_EQ(allocator->num_held_by_peer("sick"), 2);
+  }
+  EXPECT_EQ(allocator->num_held_by_peer("sick"), 1);
+  EXPECT_EQ(allocator->num_free_slots(), 2u);
+
+  // Everything released: no peer is charged, every slot is back.
+  sick2->Reset();
+  healthy0->Reset();
+  EXPECT_EQ(allocator->num_held_by_peer("sick"), 0);
+  EXPECT_EQ(allocator->num_held_by_peer("healthy"), 0);
+  EXPECT_EQ(allocator->num_free_slots(), 4u);
+}
+
+TEST(StagingBlockAllocatorTest, NoCapConfiguredLeavesAdmissionUnchanged) {
+  FakeSendBase base(/*num_layers=*/1, /*host_blocks=*/4);
+  std::unique_ptr<StagingBlockAllocator> allocator =
+      StagingBlockAllocator::Create(&base, /*num_slots=*/2, /*max_blocks=*/1,
+                                    /*dynamic_host_staging=*/false,
+                                    /*max_staged_reads_per_peer=*/0);
+  EXPECT_EQ(allocator->max_staged_reads_per_peer(), 0);
+
+  // One peer may take the whole pool, exactly as before.
+  absl::StatusOr<StagingAllocation> a = allocator->Acquire(1, "sick");
+  absl::StatusOr<StagingAllocation> b = allocator->Acquire(1, "sick");
+  ABSL_ASSERT_OK(a);
+  ABSL_ASSERT_OK(b);
+  EXPECT_EQ(allocator->num_held_by_peer("sick"), 2);
+  EXPECT_EQ(allocator->num_free_slots(), 0u);
+  EXPECT_THAT(allocator->Acquire(1, "healthy"),
+              StatusIs(absl::StatusCode::kResourceExhausted));
+}
